{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "../dist",
    "rootDir": "..",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "relay-core": ["packages/relay-core/src/index.ts"],
      "relay-core/api-url": ["packages/relay-core/src/api-url.ts"],
      "relay-daemon": ["packages/relay-daemon/src/index.ts"],
      "relay-supervisor": ["packages/relay-supervisor/src/index.ts"]
    }
  },
  "include": ["../packages/**/*.ts", "../web/tests/**/*.ts"],
  "exclude": ["../web/.next/**", "../web/src/app/**", "../web/src/components/**"]
}
