# Relay daemon runtime configuration.
# Package-local values override root .env values, but shell environment values win.

RELAY_BACKEND_URL=http://127.0.0.1:8790
RELAY_EMPLOYEE_ID=local
RELAY_SANDBOX_ID=sbx_local
RELAY_SANDBOX_MODE=none
RELAY_WORKSPACE=

# Optional fixed tokens. Leave empty to use the per-employee token files.
RELAY_DAEMON_TOKEN=
RELAY_DAEMON_NODE_TOKEN=
RELAY_DAEMON_UI_TOKEN=

# Optional agent credentials for daemon-owned execution.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
PI_API_KEY=
PI_BASE_URL=
PI_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=
# Required model ID with KIMI_API_KEY; otherwise an existing config alias.
KIMI_MODEL=
