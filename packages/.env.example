ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Codex CLI (CODEX_API_KEY is also accepted).
# Leave OPENAI_BASE_URL empty to use the native/saved provider configuration.
# Set it to use a custom compatible endpoint with the "dashscope" provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Backend storage. Leave blank for local file-backed development storage under
# .relay/. Set RELAY_STORAGE=postgres for product deployments.
RELAY_STORAGE=
RELAY_DATABASE_URL=
