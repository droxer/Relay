# Provider variables below configure BoxLite guests. Local computers use native CLI login/config.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Codex CLI (CODEX_API_KEY is also accepted).
# Leave OPENAI_BASE_URL empty to use the native/saved provider configuration.
# Set it to use a custom compatible endpoint with the "dashscope" provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# The database the backend keeps every store in (PostgreSQL for product
# deployments).
RELAY_DATABASE_URL=
