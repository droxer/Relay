# Provider variables below configure BoxLite guests. Local computers use native CLI login/config.
# Shared TypeScript runtime and agent credential defaults.
# Package-local values override root .env values, but shell environment values win.

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
CODEX_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

PI_API_KEY=
PI_BASE_URL=
PI_MODEL=
PI_PROVIDER=
PI_API=

KIMI_API_KEY=
KIMI_BASE_URL=
# Required model ID with KIMI_API_KEY; otherwise an existing config alias.
KIMI_MODEL=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
MOONSHOT_MODEL=

RELAY_WORKSPACE=
WORKSPACE=
