# Backend service configuration.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8790
RELAY_DATA_DIR=.relay

# PostgreSQL migration/storage target.
RELAY_DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relay
RELAY_AUTH_STORE=database
RELAY_DAEMON_STORE=database

# Optional backend behavior.
# RELAY_ADMIN_TOKEN is used only to bootstrap the first admin account via
# POST /auth/bootstrap. After the first admin is created, users authenticate
# with session cookies from POST /auth/login.
RELAY_ADMIN_TOKEN=change-me-admin-token
RELAY_CONTROL_PANEL_VERSION=python
RELAY_WEB_UI_DIST_DIR=web/out
RELAY_DAEMON_NODE_LIVENESS_TIMEOUT_MS=15000
RELAY_DAEMON_RUN_TIMEOUT_MS=900000
RELAY_PREPARED_ADMISSION_LEASE_SECONDS=60
RELAY_TASK_SCHEDULER_ENABLED=1
RELAY_TASK_SCHEDULER_INTERVAL_SECONDS=10
RELAY_TASK_SCHEDULER_MAX_DISPATCHES=5

# Logging level for the backend (DEBUG, INFO, WARNING, ERROR). Default is INFO.
RELAY_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Hosted deployment (backend and web UI on different origins).
# Unset for a single-origin install, where the backend serves the web UI at /.
# See docs/deployment.md.
# ---------------------------------------------------------------------------

# Public API origin used in computer connection commands, independent of the
# internal proxy hostname/scheme. Set this on the backend in production.
# Do not include /api/v1. Use the API domain when web and API hosts differ.
# RELAY_PUBLIC_BACKEND_URL=https://api.example.com

# Browser origins allowed to call the API with session cookies. Comma-separated
# exact origins; '*' is rejected because credentialed CORS forbids a wildcard.
# RELAY_CORS_ALLOW_ORIGINS=https://relay.example.com
# Anchored pattern for ephemeral preview deployments.
# RELAY_CORS_ALLOW_ORIGIN_REGEX=https://relay-web-[a-z0-9-]+\.vercel\.app

# Session cookie shape. Sibling subdomains (app./api. of one domain) are
# same-site: keep samesite=lax and set the shared parent as the domain.
# Unrelated domains (*.vercel.app -> *.up.railway.app) are cross-site and need
# samesite=none, which implies Secure.
# RELAY_SESSION_COOKIE_DOMAIN=.example.com
# RELAY_SESSION_COOKIE_SAMESITE=lax
# RELAY_FORCE_SECURE_COOKIES=1

# Honor X-Forwarded-Proto/For only from explicitly trusted load balancers.
# Disabled by default; enabling requires a proxy IP/CIDR allowlist (not '*').
# RELAY_TRUST_PROXY_HEADERS=1
# RELAY_FORWARDED_ALLOW_IPS=10.0.0.0/8

# Cap on one SSE connection, in seconds (default 1800). Set below the proxy's
# own stream limit so the client gets a resumable close instead of a hard cut.
# RELAY_STREAM_MAX_SECONDS=240
