# Next.js backend proxy target used by web/next.config.ts.
RELAY_BACKEND_URL=http://127.0.0.1:8790

# Legacy alias accepted by the web config.
# RELAY_DAEMON_URL=http://127.0.0.1:8790

# ---------------------------------------------------------------------------
# Hosting the web UI separately from the backend (e.g. Vercel).
# Unset for the default build, a static export served by the backend at /.
# See docs/deployment.md.
# ---------------------------------------------------------------------------

# Build a Node app whose rewrites proxy /api and /profile-images to
# RELAY_BACKEND_URL. Keeps the browser same-origin, so the session cookie needs
# no cross-site handling and the backend needs no CORS.
# RELAY_WEB_HOST=proxy

# Alternative to proxying: call the backend origin directly from the browser.
# Requires RELAY_CORS_ALLOW_ORIGINS and a cross-site cookie on the backend.
# Leave unset when using RELAY_WEB_HOST=proxy.
# NEXT_PUBLIC_RELAY_API_ORIGIN=https://api.example.com

# Public backend origin shown in copy-out values (daemon start commands, chat
# webhook base URLs) when the browser reaches the API through a proxy. Only
# needed in proxied mode; direct mode reuses NEXT_PUBLIC_RELAY_API_ORIGIN.
# NEXT_PUBLIC_RELAY_BACKEND_ORIGIN=https://api.example.com

# Chat channels are off by default. Set to 1 (at build time) to restore the
# Channels page, its command-palette entry, and the G H shortcut. The backend
# must also run with RELAY_CHANNELS_ENABLED=1, or the page's API calls 404.
# NEXT_PUBLIC_RELAY_CHANNELS_ENABLED=1
