# Copy to deploy/.env or deploy/config.env (both git-ignored) and fill in.
# deploy/deploy.sh reads it.
# Never commit the copy: it holds API tokens.

# --- Required -----------------------------------------------------------------

# Railway account or workspace token (Account Settings → Tokens). A project
# token cannot create projects or services.
RAILWAY_API_TOKEN=

# Cloudflare API token scoped to the zone, with:
#   Zone → DNS: Edit, Zone → Zone Settings: Edit,
#   Zone → Transform Rules: Edit, Zone → Cache Rules: Edit, Zone → Zone: Read,
#   Zone → Workers Routes: Edit, and Account → Workers Scripts: Edit
CLOUDFLARE_API_TOKEN=

# --- Domains (defaults shown) -------------------------------------------------

CLOUDFLARE_ZONE=get-relay.cc
# The web UI. It may be the zone apex; Cloudflare flattens the CNAME.
WEB_DOMAIN=get-relay.cc
# The backend API, daemons, and install script.
API_DOMAIN=api.get-relay.cc

# --- Web UI hosting (defaults shown) -----------------------------------------
# workers: a Cloudflare Worker serves the export from every Cloudflare location
#          (builds it locally with docker). railway: a relay-web service.
WEB_HOSTING=workers
# WORKERS_SCRIPT=relay-web

# --- Railway (defaults shown) -------------------------------------------------

# RAILWAY_WORKSPACE_ID=        # required only if the token sees several workspaces
# RAILWAY_PROJECT_ID=          # pin an existing project instead of matching by name
RAILWAY_PROJECT_NAME=relay
RAILWAY_ENVIRONMENT=production
# The Railway GitHub app must have access to this repository.
GITHUB_REPO=droxer/Relay
GITHUB_BRANCH=main
# RAILWAY_DEPLOY_COMMIT=     # optional full SHA; otherwise release resolves branch HEAD with git
# BACKEND_SERVICE=relay-backend
# WEB_SERVICE=relay-web
# POSTGRES_SERVICE=Postgres
# Where the services run. Keep it near the users: every API call crosses it.
# New services and a new Postgres are placed here; an existing Postgres is
# never moved by a re-run (that migrates its volume and takes it offline).
# RAILWAY_REGION=asia-southeast1-eqsg3a
# PG_CLIENT_MAJOR=18           # match the Postgres server's major version

# --- Optional: R2 for artifact snapshots and skill bundles --------------------
# Set all four to use R2 (deployment-cloudflare.md § 6). Without them the
# backend gets a Railway volume at /data instead.

# RELAY_R2_ACCOUNT_ID=
# RELAY_R2_ACCESS_KEY_ID=
# RELAY_R2_SECRET_ACCESS_KEY=
# RELAY_R2_BUCKET=relay-artifacts

# --- Optional: waitlist and its email (docs/waitlist-design.md) --------------
# The hosted deploy publishes the public "Request access" form and the admin
# Waitlist section by default; RELAY_WAITLIST_ENABLED=0 takes them down. Invites are emailed through Cloudflare Email Service
# when all three RELAY_MAIL_* keys are set (deployment-cloudflare.md § 10);
# without them an admin copies each invite link by hand.

# RELAY_WAITLIST_ENABLED=0
# RELAY_MAIL_CLOUDFLARE_ACCOUNT_ID=
# A token with only the Email Sending permission — not CLOUDFLARE_API_TOKEN.
# RELAY_MAIL_CLOUDFLARE_API_TOKEN=
# RELAY_MAIL_FROM=Relay <invites@mail.get-relay.cc>

# --- Optional: secrets --------------------------------------------------------
# Generated on the first run and kept in Railway afterwards. Set them here only
# to supply your own or to rotate (RELAY_EDGE_SECRET accepts "old,new").

# RELAY_EDGE_SECRET=
# RELAY_ADMIN_TOKEN=
