# Response headers for the relay-web Worker's static assets, mirroring
# web/Caddyfile (and web/vercel.json). Pages need no Cache-Control here: Workers
# assets default to revalidating, so a deploy is visible immediately.
# Cloudflare skips this file for what worker.js returns (deep links, missing
# assets), so worker.js carries the /* block too; deploy/tests/worker.mjs
# fails if the two differ.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Content-hashed filenames never change, so the edge and browser may keep them.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Landing screenshots keep their names across deploys; a day saves the repeat
# visitor's revalidations, and a replaced screenshot shows within a day.
/landing/*
  Cache-Control: public, max-age=86400
